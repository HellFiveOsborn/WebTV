{
  "name": "webtv-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:widget:css": "node scripts/generate-embed-css.mjs",
    "build:widget": "node scripts/generate-embed-css.mjs && vite build --config vite.widget.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:scripts": "tsc src/utils/scriptMinifier.ts --target es2022 --module nodenext --moduleResolution nodenext --outDir src/utils/__compiled__ && node --test tests/lint-scripts.test.mjs tests/scriptMinifier.test.mjs",
    "lint:scripts": "node tests/lint-scripts.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.4",
    "terser": "^5.48.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
