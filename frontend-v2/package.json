{
  "name": "webtv-frontend-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run fetch:channels && tsc && vite build",
    "build:offline": "tsc && vite build",
    "preview": "vite preview",
    "fetch:channels": "node scripts/fetch-channels.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "npm run test:parser && npm run test:parser:live && npm run test:storage && npm run test:cache && npm run test:theme && npm run test:apiUrl && npm run test:usage && npm run test:ranking && npm run test:dpad && npm run test:events && npm run test:channelSession && npm run test:scripts && npm run test:injection && npm run test:backend",
    "test:parser": "node --test tests/parseEmbedcanais.test.mjs",
    "test:parser:live": "node --test tests/fetchChannels.test.mjs",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:cache": "node --test tests/catalogCache.test.mjs",
    "test:theme": "node --test tests/theme.test.mjs",
    "test:apiUrl": "node --test tests/apiUrl.test.mjs",
    "test:usage": "node --test tests/usage.test.mjs",
    "test:ranking": "node --test tests/ranking.test.mjs",
    "test:dpad": "node --test tests/dpad.test.mjs",
    "test:events": "node --test tests/events.test.mjs",
    "test:channelSession": "node --test tests/channelSession.test.mjs",
    "test:scripts": "node --test tests/scripts.test.mjs",
    "test:injection": "node --test tests/injectionScripts.test.mjs",
    "test:cache:e2e": "node --test tests/cache.e2e.test.mjs",
    "test:backend": "node --test ../backend/tests/server.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
