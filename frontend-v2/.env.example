# URL BASE da API do catalogo.
#
# Padrao (quando a var nao existe): https://webtv-api.netlify.app
#
# Em dev, aponte para o backend local (proxy do Vite):
#   VITE_API_URL=/api
#
# O app acrescenta o /channels sozinho e consulta
# https://webtv-api.netlify.app/channels.
#
# O usuario pode TROCAR essa URL na tela de fallback (sem rebuild): o
# override fica no storage do aparelho e vence este valor.
VITE_API_URL=

# TTL do cache local do catalogo (localStorage), em milissegundos.
# Padrao: 1800000 (30 minutos).
#
# Enquanto o cache estiver dentro do TTL, a v2 NAO faz nenhuma requisicao
# a rede. Passado o TTL, o dado velho continua em tela (stale-while-
# revalidate) e a revalidacao acontece em segundo plano.
#
# Use 0 ou um valor invalido para desativar a configuracao (volta ao padrao).
VITE_CACHE_TTL_MS=
