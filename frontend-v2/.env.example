# URL da API do catalogo usada em PRODUCAO (Netlify Function).
# Em dev, o Vite faz proxy de /api/channels para http://127.0.0.1:8080.
#
# Producao: https://webtv-api.netlify.app/channels
# (a mesma URL vive na var de repositorio VITE_API_URL do GitHub Actions).
VITE_API_URL=

# TTL do cache local do catalogo (localStorage), em milissegundos.
# Padrao: 1800000 (30 minutos).
#
# Enquanto o cache estiver dentro do TTL, a v2 NAO faz nenhuma requisicao
# a rede. Passado o TTL, o dado velho continua em tela (stale-while-
# revalidate) e a revalidacao acontece em segundo plano.
#
# Use 0 ou um valor invalido para desativar a configuracao (volta ao padrao).
VITE_CACHE_TTL_MS=
